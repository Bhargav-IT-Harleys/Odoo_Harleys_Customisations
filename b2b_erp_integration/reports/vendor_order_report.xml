<odoo>

    <template id="vendor_order_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Vendor Order Report</h2>
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Purchase Order:</strong>
                                <span t-field="doc.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Vendor:</strong>
                                <span t-field="doc.partner_id"/>
                            </div>
                        </div>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.order_line" t-as="line">
                                    <td><span t-field="line.product_id"/></td>
                                    <td class="text-end"><span t-field="line.product_qty"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_vendor_order" model="ir.actions.report">
        <field name="name">Vendor Order Report</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">b2b_erp_integration.vendor_order_report_template</field>
        <field name="report_file">b2b_erp_integration.vendor_order_report_template</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
