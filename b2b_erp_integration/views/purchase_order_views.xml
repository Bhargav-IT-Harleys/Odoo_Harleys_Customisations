<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_purchase_order_form_vendor_integration" model="ir.ui.view">
        <field name="name">purchase.order.form.vendor.integration</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_send_to_vendor"
                    string="Send to Vendor"
                    type="object"
                    class="btn-primary"
                    invisible="not show_vendor_send_button"
                />
            </xpath>
        </field>
    </record>
</odoo>
