<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_vendor_api_log_tree" model="ir.ui.view">
        <field name="name">vendor.api.log.tree</field>
        <field name="model">vendor.api.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="purchase_order_id"/>
                <field name="vendor_id"/>
                <field name="state"/>
                <field name="http_status"/>
                <field name="vendor_order_id"/>
                <field name="sent_on"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_api_log_form" model="ir.ui.view">
        <field name="name">vendor.api.log.form</field>
        <field name="model">vendor.api.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="purchase_order_id"/>
                        <field name="account_id"/>
                        <field name="vendor_id" readonly="1"/>
                    </group>

                    <group>
                        <field name="state"/>
                        <field name="http_status"/>
                        <field name="vendor_order_id"/>
                        <field name="sent_on"/>
                    </group>

                    <notebook>

                        <page string="Request">
                            <field name="request_payload" nolabel="1"/>
                        </page>

                        <page string="Response">
                            <field name="response_payload" nolabel="1"/>
                        </page>

                        <page string="Error">
                            <field name="error_message" nolabel="1"/>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vendor_api_log" model="ir.actions.act_window">
        <field name="name">Vendor API Logs</field>
        <field name="res_model">vendor.api.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_vendor_api_logs"
        parent="menu_vendor_integration_setup"
        name="Logs"
        action="action_vendor_api_log"/>

</odoo>
