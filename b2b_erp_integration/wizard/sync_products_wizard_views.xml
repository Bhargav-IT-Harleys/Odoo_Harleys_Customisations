<odoo>
    <record id="view_sync_products_wizard_form" model="ir.ui.view">
        <field name="name">sync.products.wizard.form</field>
        <field name="model">sync.products.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Products">
                <footer>
                    <button string="Sync" type="object" name="action_sync" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
