<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_vendor_auth_wizard" model="ir.ui.view">
        <field name="name">vendor.auth.wizard.form</field>
        <field name="model">vendor.auth.wizard</field>
        <field name="arch" type="xml">
            <form string="OTP Verification">
                <group>
                    <field name="otp" string="OTP" placeholder="Enter your OTP code"/>
                </group>

                <footer>
                    <button
                        name="action_verify"
                        type="object"
                        string="Verify"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
