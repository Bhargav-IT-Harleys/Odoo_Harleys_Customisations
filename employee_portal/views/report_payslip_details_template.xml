<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="custom_report_payslip_harleys" inherit_id="hr_payroll.report_payslip">
            <xpath expr="//div" position="replace">
                <div class="page">
                    <h2 id="payslip_name"><span t-field="o.name">August 2023 Payslip</span></h2>
                    <t t-set="is_invalid" t-value="o._is_invalid()"/>
                    <div t-if="is_invalid">
                        <strong id="invalid_warning"><span t-out="is_invalid">This payslip is not validated. This is not a legal document.</span></strong>
                    </div>
                    <div t-else="">
                        <div class="oe_structure"></div>
                    </div>
                    <div id="infos_table">
                        <table class="table table-sm table-borderless">
                            <thead class="o_black_border">
                                <tr>
                                    <th>Employee Information</th>
                                    <th>Other Information</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td id="employee_infos">
                                        <div id="employee_name">
                                            <strong class="me-2">Name:</strong>
                                            <span t-field="o.employee_id.legal_name"/>
                                        </div>
                                        <div id="employee_id">
                                            <strong class="me-2">ID:</strong>
                                            <span t-if="o.employee_id.id" t-field="o.employee_id.id"/>
                                            <span t-else="" style="color:#875A7B" class="fw-bold">No ID number on the employee !!!</span>
                                        </div>
                                        <div id="employee_email" t-if="o.employee_id.work_email">
                                            <strong class="me-2">Email:</strong>
                                            <span t-field="o.employee_id.work_email"/>
                                        </div>
                                        <div id="employee_job_title" t-if="o.employee_id.job_title">
                                            <strong class="me-2">Job Position:</strong>
                                            <span t-field="o.employee_id.job_title"/>
                                        </div>
                                        <div id="employee_department" t-if="o.employee_id.department_id">
                                            <strong class="me-2">Department:</strong>
                                            <span t-field="o.employee_id.department_id"/>
                                        </div>
                                        <!-- <div id="employee_person_in_charge" t-if="o.employee_id.children">
                                            <strong class="me-2">Children:</strong>
                                            <span t-field="o.employee_id.children"/>
                                        </div> -->
                                    </td>
                                    <td id="other_infos">
                                        <!-- <div id="wage">
                                            <strong class="me-2">Contract Wage (<span class="text-capitalize" t-out="o.contract_id.schedule_pay if o.contract_id.wage_type == 'monthly' else o.contract_id.wage_type"/>):</strong>
                                            <span t-out="o.contract_id._get_contract_wage()" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}" style="color:#875A7B" class="fw-bold"/>
                                        </div> -->
                                        <!-- <div id="pay_period">
                                            <strong class="me-2">Pay Period:</strong>
                                            <span t-if="o.date_from &lt; o.contract_id.date_start" t-field="o.contract_id.date_start"/>
                                            <span t-else="" t-field="o.date_from"/>
                                            -
                                            <span t-if="o.contract_id.date_end and o.date_to &gt; o.contract_id.date_end" t-field="o.contract_id.date_end"/>
                                            <span t-else="" t-field="o.date_to"/>
                                        </div> -->
                                        <div id="computed_on">
                                            <strong class="me-2">Computed On:</strong>
                                            <span t-field="o.compute_date"/>
                                        </div>
                                        <!-- <div id="contract_start">
                                            <strong class="me-2">Contract Start Date:</strong>
                                            <span t-field="o.employee_id.first_contract_date"/>
                                        </div> -->
                                        <!-- <div id="contract_type" t-if="o.contract_id.contract_type_id">
                                            <strong class="me-2">Contract Type:</strong>
                                            <span t-field="o.employee_id.contract_id.contract_type_id"/>
                                        </div> -->
                                        <!-- <div id="working_schedule">
                                            <strong class="me-2">Working Schedule:</strong>
                                            <span t-field="o.employee_id.contract_id.hours_per_week"/> Hours / Week
                                        </div> -->
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-borderless">
                            <t t-set="timeoff_data_table" t-value="o._get_employee_timeoff_data()"/>
                                <thead class="o_black_border">
                                    <tr>
                                        <th>Bank Information</th>
                                        <th t-if="timeoff_data_table">Time-Off</th>
                                        <th>Work Days</th> 
                                    </tr>
                                </thead> 
                            <tbody>
                                <tr>
                                    <td>
                                        <div>
                                            <strong>Bank Account:</strong>
                                            <span t-field="o.employee_id.bank_account_ids"/>
                                        </div>
                                        <div>
                                            <strong>PAN:</strong>
                                            <span t-field="o.employee_id.l10n_in_pan"/>
                                        </div>
                                        <div>
                                            <strong>UAN:</strong>
                                            <span t-field="o.employee_id.l10n_in_uan"/>
                                        </div>
                                        <div>
                                            <strong>ESIC:</strong>
                                            <span t-field="o.employee_id.l10n_in_esic_number"/>
                                        </div>
                                    </td>
                                    <td t-if="timeoff_data_table">
                                        <div t-foreach="timeoff_data_table" t-as="timeoff_data">
                                            <strong t-out="timeoff_data[0] + ':'"></strong>
                                            <t t-out="timeoff_data[1].get('remaining_leaves')"/>
                                            /
                                            <span t-out="timeoff_data[1].get('max_leaves')"/>
                                            <t t-if="timeoff_data[1].get('request_unit') == 'hour'">Hours</t>
                                            <t t-else="">Days</t>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                    <div id="payslip_lines_table">
                        <table class="table table-sm table-borderless" style="width:100%;">
                            <thead class="o_black_border">
                                <tr>
                                    <th style="width:16%">Earning</th>
                                    <th class="text-end" style="width:16%">Amount</th>
                                    <th class="text-end" style="width:16%;" t-if="o.ytd_computation">YTD</th>
                                    <th style="width:16%">Deduction</th>
                                    <th class="text-end" style="width:16%">Amount</th>
                                    <th class="text-end" style="width:16%" t-if="o.ytd_computation">YTD</th>
                                    <!-- Compatibility anchors used by localization
                                         report inheritances after this template
                                         replaces the standard payslip body. -->
                                    <t t-if="False">
                                        <th id="line_header_amount"/>
                                        <th id="line_header_quantity"/>
                                        <th id="line_header_rate"/>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="False">
                                    <tr>
                                        <td id="payslip_line_amount"/>
                                        <td id="payslip_line_quantity"/>
                                        <td id="payslip_line_rate"/>
                                    </tr>
                                </t>
                                <t t-set="earn_lines" t-value="o.line_ids.filtered(lambda line: line.appears_on_payslip and line.category_id.name in ('Basic', 'Allowance', 'Taxable Salary') and not((line.name == 'Bonus' or line.name == 'Performance Bonus') and line.total == 0))"/>
                                <t t-set="deduct_lines" t-value="o.line_ids.filtered(lambda line: line.appears_on_payslip and line.category_id.name not in ('Basic', 'Allowance', 'Taxable Salary', 'Net') and not(line.name == 'Deduction Towards Leave Availed' and line.total == 0))"/>
                                <t t-set="max_lines" t-value="max(len(earn_lines), len(deduct_lines))"/>
                                <t t-foreach="range(max_lines)" t-as="i">
                                    <tr>
                                        <t t-set="earn" t-value="earn_lines[i] if i &lt; len(earn_lines) else None"/>
                                        <t t-if="earn">
                                            <t t-set="styling" t-value="earn.get_payslip_styling_dict()"/>
                                            <t t-set="line_style" t-value="styling.get(earn.code, {}).get('line_style', '')"/>
                                            <t t-set="line_class" t-value="styling.get(earn.code, {}).get('line_class', '')"/>
                                            <td t-att-class="line_class" t-att-style="line_style"><span t-field="earn.name"/></td>
                                            <td t-attf-class="#{line_class} text-end" t-att-style="line_style">
                                                <span t-out="earn.total"
                                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                                    t-att-style="'color:#875A7B;' if earn.total &lt; 0 else ''"/>
                                            </td>
                                            <td t-if="o.ytd_computation" class="text-end" style="border-right: 5px solid rgb(20, 113, 200);">
                                                <span t-esc="earn.ytd"
                                                    t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
                                                    t-att-style="'color:#875A7B;' if earn.ytd &lt; 0 else ''"/>
                                            </td>
                                        </t>
                                        <t t-if="not earn">
                                            <td/><td/><td t-if="o.ytd_computation"/>
                                        </t>
                                        <t t-set="deduct" t-value="deduct_lines[i] if i &lt; len(deduct_lines) else None"/>
                                        <t t-if="deduct">
                                            <t t-set="styling" t-value="deduct.get_payslip_styling_dict()"/>
                                            <t t-set="line_style" t-value="styling.get(deduct.code, {}).get('line_style', '')"/>
                                            <t t-set="line_class" t-value="styling.get(deduct.code, {}).get('line_class', '')"/>
                                            <td t-att-class="line_class" t-att-style="line_style"><span t-field="deduct.name"/></td>
                                            <td t-attf-class="#{line_class} text-end" t-att-style="line_style">
                                                <span t-out="deduct.total"
                                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                                    t-att-style="'color:#875A7B;' if deduct.total &lt; 0 else ''"/>
                                            </td>
                                            <td t-if="o.ytd_computation" class="text-end">
                                                <span t-esc="deduct.ytd"
                                                    t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
                                                    t-att-style="'color:#875A7B;' if deduct.ytd &lt; 0 else ''"/>
                                            </td>
                                        </t>
                                        <t t-if="not deduct">
                                            <td/><td/><td t-if="o.ytd_computation"/>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <table class="table table-sm table-borderless" style="width:100%">
                            <thead class="o_black_border">
                                <tr>
                                    <th id="line_header_name" style="width:5%">Total</th>
                                    <th id="line_header_total" style="width:5%" class="text-end">Amount</th>
                                    <th id="line_header_ytd" style="width:5%" class="text-end" t-if="o.ytd_computation">YTD</th>
                                </tr>
                            </thead>
                            <tbody id="payslip_lines">
                                <span t-foreach="o.line_ids.filtered(lambda line: line.appears_on_payslip and line.category_id.name in ('Net'))" t-as="line">
                                    <t t-set="line_styling" t-value="line.get_payslip_styling_dict()"/>
                                    <t t-set="line_style"/>
                                    <t t-set="line_class"/>
                                    <t t-if="line.code in line_styling">
                                        <t t-set="line_style" t-value="line_styling[line.code]['line_style']"/>
                                        <t t-set="line_class" t-value="line_styling[line.code]['line_class']"/>
                                    </t>
                                    <tr id="line_display">
                                        <td id="payslip_line_name" style="width:5%" t-att-class="line_class" t-att-style="line_style"><span t-field="line.name"/></td>
                                        <td id="payslip_line_total" style="width:5%" t-attf-class="#{line_class} text-end" t-att-style="line_style">
                                            <span t-out="line.total"
                                                t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                                t-att-style="'color:#875A7B;' if line.total &lt; 0 else ''"/>
                                        </td>
                                        <td id="payslip_line_ytd" style="width:5%" t-if="o.ytd_computation" class="text-end">
                                            <span t-esc="line.ytd"
                                                t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
                                                t-att-style="'color:#875A7B;' if line.ytd &lt; 0 else ''"/>
                                        </td>
                                    </tr>
                                </span>
                            </tbody>
                        </table>
                        <div class="oe_structure"></div>
                    </div>
                </div>
            </xpath>

        </template>

        <!-- <template id="inherit_l10n_in_to_pay" inherit_id="l10n_in_hr_payroll.l10n_in_to_pay">
            <xpath expr="//div[1]" position="replace">
                    <div t-if="o.net_wage &gt;= 0">
                        Amount In Words Rs: <span t-out="o.currency_id.with_context(lang='en_US').amount_to_text(o.net_wage)"/>
                    </div>
            </xpath>
            <xpath expr="//div[3]" position="replace"/>
        </template> -->

    </data>
</odoo>
