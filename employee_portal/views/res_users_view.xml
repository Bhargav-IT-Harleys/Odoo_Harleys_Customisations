<odoo>
    <record id="view_users_form_inherit_remove_invisible" model="ir.ui.view">
        <field name="name">res.users.form.inherit.remove.invisible</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Locate the button by its name -->
            <xpath expr="//button[@name='action_create_employee']" position="attributes">
                <!-- Remove the invisible attribute -->
                <attribute name="invisible"/>
            </xpath>
        </field>
    </record>
</odoo>
