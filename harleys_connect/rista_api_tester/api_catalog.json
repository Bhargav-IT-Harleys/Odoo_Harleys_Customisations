{
  "apis": [
    {
      "id": "branch_list",
      "name": "Branch List",
      "category": "Business",
      "method": "GET",
      "path": "/branch/list",
      "description": "Get all branch information",
      "request_type": "none",
      "type": "api",
      "enabled": true
    },
    {
      "id": "sales_summary",
      "name": "Sales Summary",
      "category": "Analytics",
      "method": "GET",
      "path": "/analytics/sales/summary",
      "description": "Get sales summary",
      "request_type": "query",
      "type": "api",
      "enabled": true,
      "parameters": [
        "branch",
        "period"
      ],
      "field_mapping": {
        "Date": "request.period",
        "Sale Item Qty": "itemTotalQty",
        "Taxes": "taxTotal",
        "Direct Charge": "channelSummary[].directCharge",
        "Indirect Charge": "channelSummary[].indirectCharge",
        "Channel": "channelSummary[].name",
        "Payment Modes": "payments[].mode"
      }
    },
    {
      "id": "custom_sales_summary",
      "name": "Custom Sales Summary",
      "category": "Analytics",
      "method": "GET",
      "path": "/analytics/custom/sales/summary",
      "description": "Get custom sales summary",
      "request_type": "query",
      "type": "api",
      "enabled": true,
      "parameters": [
        "branch",
        "fromDate",
        "toDate"
      ]
    },
    {
      "id": "tally_sales_summary",
      "name": "Tally Sales Summary",
      "category": "Analytics",
      "method": "GET",
      "path": "/analytics/tally/sales/summary",
      "description": "Get tally sales summary",
      "request_type": "query",
      "type": "api",
      "enabled": true,
      "parameters": [
        "branch",
        "fromDate",
        "toDate"
      ]
    },
    {
      "id": "customer_list",
      "name": "Customer List",
      "category": "Business",
      "method": "GET",
      "path": "/customer/list",
      "description": "Get all customers",
      "request_type": "none",
      "type": "api",
      "enabled": true
    },
    {
      "id": "item_list",
      "name": "Item List",
      "category": "Inventory",
      "method": "GET",
      "path": "/item/list",
      "description": "Get all items",
      "request_type": "none",
      "type": "api",
      "enabled": true
    },
    {
      "id": "stock_list",
      "name": "Stock List",
      "category": "Inventory",
      "method": "GET",
      "path": "/stock/list",
      "description": "Get stock details",
      "request_type": "query",
      "type": "api",
      "enabled": true,
      "parameters": [
        "branch"
      ]
    },
    {
      "id": "grn_list",
      "name": "GRN List",
      "category": "Inventory",
      "method": "GET",
      "path": "/grn/list",
      "description": "Get GRN list",
      "request_type": "query",
      "type": "api",
      "enabled": true,
      "parameters": [
        "branch",
        "fromDate",
        "toDate"
      ]
    },
    {
      "id": "purchase_order_list",
      "name": "Purchase Order List",
      "category": "Inventory",
      "method": "GET",
      "path": "/purchase-order/list",
      "description": "Get purchase orders",
      "request_type": "query",
      "type": "api",
      "enabled": true,
      "parameters": [
        "branch",
        "fromDate",
        "toDate"
      ]
    },
    {
      "id": "discount_transactions",
      "name": "Discount Transactions",
      "category": "Analytics",
      "method": "GET",
      "path": "/analytics/discount/transactions",
      "description": "Get discount transactions",
      "request_type": "query",
      "type": "api",
      "enabled": true,
      "parameters": [
        "branch",
        "day",
        "lastKey"
      ],
      "field_mapping": {
        "Invoice Date": "invoiceDate",
        "Invoice Number": "invoiceNumber",
        "Invoice Type": "invoiceType",
        "Discount Code": "discountCode",
        "Discount Amount": "discountAmount",
        "Discount Percentage": "discountPercentage",
        "Coupon Code": "couponCode",
        "Coupon Provider": "couponProvider",
        "Campaign Name": "campaignName",
        "Bill Net Discount": "billNetDiscount",
        "Bill Gross Amount": "billGrossAmount",
        "Sale Amount": "saleAmount",
        "Applied By": "appliedBy",
        "Reason": "reason"
      }
    },
    {
      "id": "all_branch_sales_summary",
      "name": "All Branch Sales Summary",
      "category": "Workflows",
      "type": "workflow",
      "enabled": true,
      "workflow": {
        "type": "branch_iteration",
        "branch_api": "branch_list",
        "sales_api": "sales_summary"
      }
    }
  ]
}
