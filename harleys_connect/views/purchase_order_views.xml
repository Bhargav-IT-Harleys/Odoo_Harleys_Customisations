<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_purchase_order_form_vendor_integration" model="ir.ui.view">
        <field name="name">purchase.order.form.vendor.integration</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_send_to_vendor"
                    string="Send to Vendor"
                    type="object"
                    class="btn-primary"
                    invisible="not show_vendor_send_button"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_vendor_api_logs" type="object"
                        class="oe_stat_button" icon="fa-exchange"
                        invisible="not vendor_api_log_count">
                    <field name="vendor_api_log_count" widget="statinfo" string="Vendor API Logs"/>
                </button>
                <button name="action_view_vendor_webhook_logs" type="object"
                        class="oe_stat_button" icon="fa-bell"
                        invisible="not vendor_webhook_log_count">
                    <field name="vendor_webhook_log_count" widget="statinfo" string="Vendor Webhooks"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="vendor_order_id" invisible="not vendor_order_sent"/>
                <field name="vendor_order_number" invisible="not vendor_order_number"/>
                <field name="vendor_order_status" invisible="not vendor_order_status"/>
            </xpath>
        </field>
    </record>
</odoo>
