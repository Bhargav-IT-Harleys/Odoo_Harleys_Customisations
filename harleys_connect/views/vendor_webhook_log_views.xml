<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_vendor_webhook_log_list" model="ir.ui.view">
        <field name="name">vendor.webhook.log.list</field>
        <field name="model">vendor.webhook.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="platform_id"/>
                <field name="account_id"/>
                <field name="purchase_order_id"/>
                <field name="outlet_id"/>
                <field name="http_status"/>
                <field name="status"/>
                <field name="company_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_webhook_log_form" model="ir.ui.view">
        <field name="name">vendor.webhook.log.form</field>
        <field name="model">vendor.webhook.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="platform_id"/>
                        <field name="account_id"/>
                        <field name="vendor_code"/>
                        <field name="purchase_order_id"/>
                        <field name="outlet_id"/>
                        <field name="vendor_event_id"/>
                        <field name="idempotency_key"/>
                        <field name="http_status"/>
                        <field name="status"/>
                        <field name="company_id"/>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field name="request_payload" nolabel="1"/>
                        </page>
                        <page string="Response">
                            <field name="response_payload" nolabel="1"/>
                        </page>
                        <page string="Error" invisible="not error_message">
                            <field name="error_message" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vendor_webhook_log" model="ir.actions.act_window">
        <field name="name">Vendor Webhook Logs</field>
        <field name="res_model">vendor.webhook.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_vendor_webhook_logs"
        parent="menu_vendor_integration_setup"
        name="Webhook Logs"
        action="action_vendor_webhook_log"
        sequence="4"/>

</odoo>
