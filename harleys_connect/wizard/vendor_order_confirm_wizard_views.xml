<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_vendor_order_confirm_wizard" model="ir.ui.view">
        <field name="name">vendor.order.confirm.wizard.form</field>
        <field name="model">vendor.order.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Order to Vendor">
                <group>
                    <field name="purchase_order_id" readonly="1"/>
                    <field name="account_id" invisible="1"/>
                    <field name="outlet_id"/>
                </group>

                <field name="price_check_summary" invisible="not price_check_summary" readonly="1"/>

                <field name="line_ids" readonly="1">
                    <list decoration-danger="price_mismatch">
                        <field name="product_id"/>
                        <field name="product_qty"/>
                        <field name="our_price"/>
                        <field name="vendor_price"/>
                        <field name="mismatch_note"/>
                    </list>
                </field>

                <group invisible="not has_price_mismatch">
                    <field name="send_without_price_match"/>
                </group>

                <footer>
                    <button
                        name="action_check_prices"
                        type="object"
                        string="Refresh Prices"
                        class="btn-secondary"/>

                    <button
                        name="action_confirm_send"
                        type="object"
                        string="Confirm &amp; Send"
                        class="btn-primary"/>

                    <button
                        string="Close"
                        special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
