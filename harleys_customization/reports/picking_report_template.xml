<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Target the base report layout wrapper used in Odoo 19 Community -->
    <template id="report_picking_operation_flat_inherit" inherit_id="stock.report_picking">

        <!-- Target and replace the table inside the base picking layout -->
        <xpath expr="//table" position="replace">

            <!-- CONDITION: Apply the custom layout structure strictly to Internal Transfers -->
            <t t-if="o.picking_type_id.code == 'internal'">

                <!-- FIX: Header division wrapper removed. Locations are now inside the thead element below -->
                <table class="table table-bordered table-sm mt48" name="stock_move_line_table" style="table-layout: fixed; width: 100%; border-collapse: collapse; border: 1px solid #000000;">
                    <thead>
                        <!-- REPEATING SUB-HEADER ROW: Nested inside thead to force repetition on every page break sheet -->
                        <tr style="border: none !important; background-color: #ffffff;">
                            <th colspan="3" style="border: none !important; padding: 8px 4px; font-size: 13px; font-weight: normal; text-align: left;">
                                <strong>From (Source Location): </strong>
                                <span t-field="o.location_id.display_name"/>
                            </th>
                            <th colspan="3" style="border: none !important; padding: 8px 4px; font-size: 13px; font-weight: normal; text-align: right;">
                                <strong>To (Destination Location): </strong>
                                <span t-field="o.location_dest_id.display_name"/>
                                <t t-if="o.partner_id">
                                    <strong> | Contact: </strong>
                                    <span t-field="o.partner_id.display_name"/>
                                </t>
                            </th>
                        </tr>

                        <!-- Main Columns Heading Row -->
                        <tr style="background-color: #f8f9fa; border-bottom: 2px solid #000000;">
                            <th style="width: 30%; border: 1px solid #000000;" class="text-start align-middle"><strong>Product</strong></th>
                            <th style="width: 12%; border: 1px solid #000000;" class="text-center align-middle"><strong>Order Quantity</strong></th>
                            <th style="width: 18%; border: 1px solid #000000;" class="text-center align-middle"><strong>Batch/Lot Number</strong></th>
                            <th style="width: 10%; border: 1px solid #000000;" class="text-center align-middle"><strong>Picking Qty</strong></th>
                            <th style="width: 18%; border: 1px solid #000000;" class="text-center align-middle"><strong>Barcode</strong></th>
                            <th style="width: 12%; border: 1px solid #000000;" class="text-center align-middle"><strong>Status</strong></th>
                        </tr>
                    </thead>

                    <tbody>
                        <!-- Loop parent items array directly to handle horizontal grid alignment -->
                        <t t-foreach="o.move_ids" t-as="move">
                            <t t-set="move_lines" t-value="move.move_line_ids"/>
                            <t t-set="total_rows" t-value="len(move_lines) if move_lines else 1"/>

                            <!-- Alternate a light background per MOVE GROUP (not per row) so all lines
                                 belonging to the same product are visually banded together, even though
                                 there is no rowspan and no border between them. This is what replaces the
                                 merged-cell look and removes the "which item does this batch belong to"
                                 confusion. -->
                            <t t-set="group_bg" t-value="'#ffffff' if move_index % 2 == 0 else '#f4f6f8'"/>

                            <!-- CASE A: If NO specific stock lines or lots are assigned -->
                            <t t-if="not move_lines">
                                <tr t-attf-style="border-bottom: 2px solid #000000; background-color: #{group_bg}; page-break-inside: avoid; break-inside: avoid;">
                                    <td style="border: 1px solid #000000; border-bottom: 2px solid #000000;" class="text-start align-middle">
                                        <span t-field="move.product_id.display_name"/>
                                    </td>
                                    <td style="border: 1px solid #000000; border-bottom: 2px solid #000000;" class="text-center align-middle">
                                        <span t-field="move.product_uom_qty"/>
                                        <span t-field="move.product_uom.name" groups="uom.group_uom"/>
                                    </td>
                                    <td style="border: 1px solid #000000; border-bottom: 2px solid #000000;" class="text-center align-middle text-muted">NA</td>
                                    <td style="border: 1px solid #000000; border-bottom: 2px solid #000000;" class="text-center align-middle text-muted">NA</td>
                                    <td style="border: 1px solid #000000; border-bottom: 2px solid #000000;" class="text-center align-middle text-muted">NA</td>
                                    <td style="border: 1px solid #000000; border-bottom: 2px solid #000000;" class="text-center align-middle fw-bold text-danger">
                                        <span>Not Available</span>
                                    </td>
                                </tr>
                            </t>

                            <!-- CASE B: Batch line partitions exist.
                                 NO ROWSPAN: Product / Order Qty / Status are repeated in FULL on every
                                 single line row of this move (never left blank), so there is never any
                                 ambiguity about which product a batch/lot line belongs to, and every line
                                 shows its own Status. The whole group also shares the same background
                                 shade (group_bg) so the lines still read as one visual block. Borders
                                 between lines of the same move are removed; a bold border marks the end
                                 of the group. Every <tr> is fully independent, so page breaks can never
                                 slice through a merged cell. -->
                            <t t-else="">
                                <t t-foreach="move_lines" t-as="line">
                                    <t t-set="is_last" t-value="line_index == total_rows - 1"/>
                                    <tr t-attf-style="background-color: #{group_bg}; page-break-inside: avoid; break-inside: avoid;">
                                        <td t-attf-style="border-left: 1px solid #000000; border-right: 1px solid #000000; border-top: none; border-bottom: #{'2px solid #000000' if is_last else 'none'};" class="text-start align-middle">
                                            <span t-field="move.product_id.display_name"/>
                                        </td>
                                        <td t-attf-style="border-left: 1px solid #000000; border-right: 1px solid #000000; border-top: none; border-bottom: #{'2px solid #000000' if is_last else 'none'};" class="text-center align-middle">
                                            <span t-field="move.product_uom_qty"/>
                                            <span t-field="move.product_uom.name" groups="uom.group_uom"/>
                                        </td>

                                        <!-- Discrete lot allocation columns positioned cleanly side-by-side -->
                                        <td t-attf-style="border-left: 1px solid #000000; border-right: 1px solid #000000; border-top: none; border-bottom: #{'2px solid #000000' if is_last else '1px solid #000000'};" class="text-center align-middle">
                                            <span t-if="line.lot_id" t-field="line.lot_id.name"/>
                                            <span t-elif="line.lot_name" t-field="line.lot_name"/>
                                            <span t-else="" class="text-muted">NA</span>
                                        </td>
                                        <td t-attf-style="border-left: 1px solid #000000; border-right: 1px solid #000000; border-top: none; border-bottom: #{'2px solid #000000' if is_last else '1px solid #000000'};" class="text-center align-middle">
                                            <span t-field="line.quantity"/>
                                        </td>

                                        <!-- PRESERVED BARCODE COLUMN: Generates actual scannable Code128 bar images inline with the current batch line -->
                                        <td t-attf-style="border-left: 1px solid #000000; border-right: 1px solid #000000; border-top: none; border-bottom: #{'2px solid #000000' if is_last else '1px solid #000000'}; padding: 5px 2px;" class="text-center align-middle">
                                            <t t-if="line.lot_id and line.lot_id.name">
                                                <div t-field="line.lot_id.name" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 400, 'height': 100, 'img_style': 'max-height: 28px; max-width: 100%; display: block; margin: 0 auto;'}"/>
                                            </t>
                                            <t t-elif="line.lot_name">
                                                <div t-field="line.lot_name" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 400, 'height': 100, 'img_style': 'max-height: 28px; max-width: 100%; display: block; margin: 0 auto;'}"/>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted" style="font-size: 11px;">NA</span>
                                            </t>
                                        </td>

                                        <!-- Status column: also repeated in FULL on every line, never blank -->
                                        <td t-attf-style="border-left: 1px solid #000000; border-right: 1px solid #000000; border-top: none; border-bottom: #{'2px solid #000000' if is_last else 'none'};" class="text-center align-middle fw-bold text-success">
                                            <span>Available</span>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </t>
                    </tbody>
                </table>
            </t>

            <!-- FALLBACK: Standard Odoo document data parsing for traditional receipts/delivery orders -->
            <t t-else="">
                <table class="table table-sm" t-attf-class="table table-sm {{'table-striped' if compact else ''}}" name="stock_move_line_table">
                    <t t-set="has_barcode" t-value="any(m.product_id.barcode for m in o.move_line_ids)"/>
                    <t t-set="has_serial_number" t-value="any(m.lot_id or m.lot_name for m in o.move_line_ids)" groups="stock.group_production_lot"/>
                    <thead>
                        <tr>
                            <th name="th_product"><strong>Product</strong></th>
                            <th name="th_quantity" class="text-center"><strong>Quantity</strong></th>
                            <th name="th_from" t-if="o.picking_type_id.code != 'incoming'" align="left" groups="stock.group_stock_multi_locations"><strong>From</strong></th>
                            <th name="th_to" t-if="o.picking_type_id.code != 'outgoing'" align="left" groups="stock.group_stock_multi_locations"><strong>To</strong></th>
                            <th name="th_serial_number" class="text-center" t-if="has_serial_number"><strong>Lot/Serial Number</strong></th>
                            <th name="th_barcode" class="text-center" t-if="has_barcode"><strong>Product Barcode</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.move_line_ids" t-as="line">
                            <tr>
                                <td><span t-field="line.product_id.display_name"/></td>
                                <td class="text-center"><span t-field="line.quantity"/> <span t-field="line.product_uom_id.name"/></td>
                                <td t-if="o.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations"><span t-field="line.location_id.name"/></td>
                                <td t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations"><span t-field="line.location_dest_id.name"/></td>
                                <td class="text-center" t-if="has_serial_number"><span t-field="line.lot_id.name"/></td>
                                <td class="text-center" t-if="has_barcode"><span t-field="line.product_id.barcode"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>

        </xpath>
    </template>
</odoo>