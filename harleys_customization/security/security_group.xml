<odoo>
  <data noupdate="1">

    <record id="group_show_contacts" model="res.groups">
      <field name="name">Show Contacts</field>
    </record>

    <record id="group_bom_create_edit_access" model="res.groups">
      <field name="name">BOM Create/ Edit Access</field>
      <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>


    <!-- Group Privilege Category for Indent Request -->
    <record model="res.groups.privilege" id="res_groups_privilege_indent_request">
      <field name="name">Indent Request</field>
      <field name="sequence">9</field>
      <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <!-- Indent Request User Group -->
    <record id="group_indent_user" model="res.groups">
      <field name="name">User</field>
      <field name="sequence">10</field>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
      <field name="privilege_id" ref="harleys_customization.res_groups_privilege_indent_request"/>
    </record>

    <!-- Indent Request Admin Group -->
    <record id="group_indent_admin" model="res.groups">
      <field name="name">Administrator</field>
      <field name="sequence">20</field>
      <field name="privilege_id" ref="harleys_customization.res_groups_privilege_indent_request"/>
      <field name="implied_ids" eval="[(4, ref('harleys_customization.group_indent_user'))]"/>
      <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi Company -->

    <record model="ir.rule" id="indent_request_comp_rule">
        <field name="name">Indent Request multi-company</field>
        <field name="model_id" ref="model_indent_request" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>
    <record model="ir.rule" id="indent_request_line_comp_rule">
        <field name="name">Indent Request Line multi-company</field>
        <field name="model_id" ref="model_indent_request_line" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>
    <record id="indent_request_followers_rule" model="ir.rule">
        <field name="name">Follow Indent Request</field>
        <field name="model_id" ref="model_indent_request" />
        <field name="groups" eval="[(6,0, [ref('group_indent_user')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="indent_request_rule" model="ir.rule">
        <field name="name">Indent Request User</field>
        <field name="model_id" ref="model_indent_request" />
        <field name="groups" eval="[(6,0, [ref('group_indent_user')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="domain_force">[('requested_by','=',user.id)]</field>
    </record>
    <record id="indent_request_manager_rule" model="ir.rule">
        <field name="name">Indent Request Manager</field>
        <field name="model_id" ref="model_indent_request" />
        <field name="groups" eval="[(6,0, [ref('group_indent_admin')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="indent_template_request_line_followers_rule" model="ir.rule">
        <field name="name">Follow Indent Request Line</field>
        <field name="model_id" ref="model_indent_request_line" />
        <field name="groups" eval="[(6,0, [ref('group_indent_user')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">
            ['|',('request_id.requested_by','=',user.id),
                                        ('request_id.message_partner_ids', 'in',
            [user.partner_id.id])]
        </field>
    </record>
    <record id="indent_request_line_rule" model="ir.rule">
        <field name="name">Indent Request Line User</field>
        <field name="model_id" ref="model_indent_request_line" />
        <field name="groups" eval="[(6,0, [ref('group_indent_user')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <!-- <field name="domain_force">[('request_id.requested_by','=',user.id)]</field> -->
    </record>
    <record id="indent_request_line_manager_rule" model="ir.rule">
        <field name="name">Indent Request Line Manager</field>
        <field name="model_id" ref="model_indent_request_line" />
        <field name="groups" eval="[(6,0, [ref('group_indent_admin')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <!-- Multi Company For Indent Template-->

    <record model="ir.rule" id="indent_request_template_comp_rule">
        <field name="name">Indent Request Template multi-company</field>
        <field name="model_id" ref="model_indent_request_templates" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>
    <record model="ir.rule" id="indent_request_line_templates_comp_rule">
        <field name="name">Indent Request Line Templates multi-company</field>
        <field name="model_id" ref="model_indent_request_line_templates" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>
    <record id="indent_request_templates_followers_rule" model="ir.rule">
        <field name="name">Follow Indent Request Templates</field>
        <field name="model_id" ref="model_indent_request_templates" />
        <field name="groups" eval="[(6,0, [ref('group_indent_user')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">
            [('message_partner_ids', 'in', [user.partner_id.id])]
        </field>
    </record>
    <record id="indent_request_templates_rule" model="ir.rule">
        <field name="name">Indent Request Templates User</field>
        <field name="model_id" ref="model_indent_request_templates" />
        <field name="groups" eval="[(6,0, [ref('group_indent_user')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
    <record id="indent_request_templates_manager_rule" model="ir.rule">
        <field name="name">Indent Request Templates Manager</field>
        <field name="model_id" ref="model_indent_request_templates" />
        <field name="groups" eval="[(6,0, [ref('group_indent_admin')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="indent_request_line_templates_followers_rule" model="ir.rule">
        <field name="name">Follow Indent Request Line Templates</field>
        <field name="model_id" ref="model_indent_request_line_templates" />
        <field name="groups" eval="[(6,0, [ref('group_indent_user')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">
            [('request_id.message_partner_ids', 'in', [user.partner_id.id])]
        </field>
    </record>
    <record id="indent_request_line_templates_rule" model="ir.rule">
        <field name="name">Indent Request Line Templates User</field>
        <field name="model_id" ref="model_indent_request_line_templates" />
        <field name="groups" eval="[(6,0, [ref('group_indent_user')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
    <record id="indent_request_line_templates_manager_rule" model="ir.rule">
        <field name="name">Indent Request Line Templates Manager</field>
        <field name="model_id" ref="model_indent_request_line_templates" />
        <field name="groups" eval="[(6,0, [ref('group_indent_admin')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
  </data>
</odoo>
