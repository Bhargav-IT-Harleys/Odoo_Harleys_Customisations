<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="harleys_customization.StockMoveLineBatchField">
        <div class="o_harleys_batch_qty_editor o_harleys_batch_field d-flex flex-column gap-1">
            <t t-foreach="rows" t-as="row" t-key="row.key">
                <span class="o_harleys_batch_qty_value o_harleys_batch_lot_value">
                    <t t-esc="row.lotName"/>
                    <a t-if="!isLocked and row.lot" href="#" class="o_harleys_batch_lot_delete"
                        t-on-click.prevent="() => this.deleteLot(row.lot)">
                        <i class="oi oi-close"/>
                    </a>
                    <a t-elif="!isLocked" href="#" class="o_harleys_batch_lot_delete"
                        t-on-click.prevent="() => this.deleteLine(row.line)">
                        <i class="oi oi-close"/>
                    </a>
                </span>
            </t>
            <div t-if="ui.adding" t-ref="autocompleteWrapper" t-on-focusout="onAutocompleteFocusOut">
                <Many2XAutocomplete
                    id="props.id"
                    placeholder="props.placeholder"
                    resModel="relation"
                    autoSelect="true"
                    fieldString="props.string || 'Batch'"
                    activeActions="activeActions"
                    update="update"
                    quickCreate="activeActions.create ? quickCreate : null"
                    context="props.context"
                    getDomain.bind="getDomain"
                    isToMany="true"
                    nameCreateField="props.nameCreateField"
                    searchThreshold="props.searchThreshold"
                />
            </div>
            <button t-elif="!isLocked"
                    type="button"
                    class="o_harleys_batch_add_btn"
                    data-tooltip="Add Batch"
                    t-on-click.stop="showAddInput">
                <i class="fa fa-plus-circle"/>
                <span>Add</span>
            </button>
        </div>
    </t>
</templates>
