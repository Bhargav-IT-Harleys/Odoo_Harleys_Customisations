<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_move_form_harleys_restrict" model="ir.ui.view">
        <field name="name">account.move.form.harleys.restrict</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_post']" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>
            <xpath expr="//form//field[@name='ref']" position="attributes">
                <attribute name="required">move_type == 'in_invoice'</attribute>
            </xpath>
            <xpath expr="//form//field[@name='invoice_date']" position="attributes">
                <attribute name="required">move_type == 'in_invoice'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
