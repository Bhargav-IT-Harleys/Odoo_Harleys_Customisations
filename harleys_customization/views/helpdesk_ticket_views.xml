<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="custom_helpdesk_ticket_form_inherit" model="ir.ui.view">
        <field name="name">custom.helpdesk.ticket.form.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email_cc']" position="after">
                <field name="department_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="service_type_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="location_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>