<odoo>
  <data>
    <record id="view_indent_request_templates_form" model="ir.ui.view">
        <field name="name">indent.request.templates.form</field>
        <field name="model">indent.request.templates</field>
        <field name="arch" type="xml">
            <form string="Outlet Wise Indent Template">
                <sheet>
                    <div class="oe_edit_only">
                        <label for="name" class="oe_inline"/>
                    </div>
                    <h1>
                        <field name="name" class="oe_inline" readonly="1" force_save="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="delivery_from" required="1"/>
                            <field name="delivery_to" required="1"/>
                            <field name="company_id" groups="base.group_multi_company" widget="selection"/>
                        </group>
                        <group>
                            <field name="employee_ids" widget="many2many_tags"/>
                            <field name="password" password="True"/>
                            <field name="retype_password" password="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="line_ids">
                            <field name="line_ids">
                                <list string="Indent Request Lines Templates" editable="bottom" limit="200">
                                    <field name="request_id" column_invisible="True"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="name"/>
                                    <field name="default_code"/>
                                    <field name="hsn_code"/>
                                    <field name="product_uom_id" readonly="1"/>
                                    <field name="product_qty"/>
                                    <field name="comments"/>
                                    <field
                                            name="company_id"
                                            groups="base.group_multi_company"
                                            widget="selection"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="view_indent_request_templates_tree" model="ir.ui.view">
        <field name="name">indent.request.templates.list</field>
        <field name="model">indent.request.templates</field>
        <field name="arch" type="xml">
            <list
                    name="Outlet Wise Indent Template"
            >
                <field name="name"/>
                <field name="delivery_from"/>
                <field name="delivery_to"/>
                <field
                        name="company_id"
                        groups="base.group_multi_company"
                        widget="selection"
                />
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>


    <record model="ir.actions.act_window" id="indent_request_templates_form_action">
        <field name="name">Outlet Wise Indent Template</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">indent.request.templates</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to start a new Indent request template process.
            </p>
        </field>
    </record>


    <menuitem name="Outlet Wise Indent Template" id="harleys_customization.menu_sub_indent_request_template" parent="harleys_customization.menu_indent_request"
              action="harleys_customization.indent_request_templates_form_action"/>

  </data>
</odoo>
