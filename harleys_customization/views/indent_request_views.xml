<odoo>
  <data>
    <record id="view_indent_request_form" model="ir.ui.view">
        <field name="name">indent.request.form</field>
        <field name="model">indent.request</field>
        <field name="arch" type="xml">
            <form string="Indent Request">
                <header>
                    <button
                            type="object"
                            string="Send"
                            name="action_sent"
                            icon="fa-paper-plane"
                            class="oe_highlight"
                            invisible="state in ('sent', 'locked', 'closed')"
                    />
                    <button
                            type="object"
                            string="Close"
                            name="action_close"
                            class="btn btn-danger"
                            invisible="state not in ('locked')"
                    />
                    <button
                            type="object"
                            string="Receipt"
                            name="action_get_internal_transfers"
                            class="btn-info"
                            invisible="state not in ('locked')"
                    />
                    <field
                            name="state"
                            widget="statusbar"
                            statusbar_visible="draft,sent,locked"
                            statusbar_colors='{"sent":"blue"}'
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_get_internal_transfers"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exchange">
                            <field name="internal_transfer_count"
                                widget="statinfo"
                                string="Internal Transfers"/>
                        </button>
                        <button name="action_get_manufacturing_order"
                                type="object"
                                class="oe_stat_button"
                                groups="mrp.group_mrp_user"
                                icon="fa-industry">
                            <field name="manufacturing_order_count"
                                widget="statinfo"
                                string="Manufacturing Orders"/>
                        </button>
                    </div>
                    <div class="oe_edit_only">
                        <label for="name" class="oe_inline"/>
                    </div>
                    <h1>
                        <field name="name" class="oe_inline" readonly="1" force_save="1"/>
                        <field name="is_editable" invisible="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="indent_template" readonly="state in ['locked', 'closed']" options="{'no_create': True}" force_save="1"/>
                            <field name="indent_date" readonly="1" force_save="1"/>
                            <field name="picking_type_id" readonly="1" invisible="0" force_save="1"/>
                            <field name="via_picking_type_id" readonly="1" invisible="0" force_save="1"/>
                            <field name="delivery_from" readonly="1" force_save="1"/>
                            <field name="via_location_id" readonly="1" invisible="0" force_save="1"/>
                            <field name="delivery_to" readonly="1" force_save="1"/>
                            <field name="company_id" groups="base.group_multi_company" widget="selection" readonly="state in ['locked', 'closed']" force_save="1"/>
                            <field name="internal_transfer_status"/>
                            <field name="manufacturing_order_status"/>
                        </group>
                        <group>
                            <field name="requested_by" readonly="1" force_save="1"/>
                            <field name="received_date" readonly="state in ['locked', 'closed']" force_save="1"/>
                            <!-- <field name="employee_id"/> -->
                            <label for="password" string="Enter Password" class="text-danger" readonly="state in ['closed']"/>
                            <div>
                                <field name="password" password="True" nolabel="1" readonly="state in ['closed']" class="o_field_password" style="width: 60%;"/>
                                <button
                                    type="object"
                                    name="action_verify_template"
                                    string="Verify"
                                    class="btn btn-primary ms-2"
                                    invisible="state in ['closed', 'locked'] or not indent_template or not password"
                                />
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="line_ids" invisible="is_valid == False">
                            <field name="line_ids" widget="searchable_x2many" readonly="state in ['locked', 'closed']">
                                <list string="Indent Request Lines" editable="bottom" limit="200">
                                    <field name="request_id" column_invisible="True"/>
                                    <field name="product_id" options="{'no_create': True}" force_save="1" domain="[('state', '=', 'approved')]"/>
                                    <field name="categ_id" force_save="1"/>
                                    <field name="name" readonly="state not in ['draft']" force_save="1" column_invisible="1"/>
                                    <field name="qty_available" readonly="1" column_invisible="1"/>
                                    <field name="product_uom_id" force_save="1" required="1" readonly="1"/>
                                    <field name="product_qty" string="Demand" force_save="1"/>
                                    <field name="received_qty"
                                        readonly="1"
                                        force_save="1"
                                        optional="hide"/>

                                    <field name="supplied_qty"
                                        readonly="1"
                                        force_save="1"
                                        optional="hide"/>
                                    <field name="comments" force_save="1" column_invisible="1"/>
                                    <field
                                            name="company_id"
                                            groups="base.group_multi_company"
                                            widget="selection"
                                            force_save="1"
                                            optional="hide"
                                    />
                                    <field name="is_editable" column_invisible="1" force_save="1" width="150px"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_indent_request_search" model="ir.ui.view">
        <field name="name">Indent Requests Search</field>
        <field name="model">indent.request</field>
        <field name="arch" type="xml">
            <search string="Indent Request">
                <field name="name"/>
                <field name="delivery_from"/>
                <field name="delivery_to"/>
                <field name="requested_by"/>
                <field name="product_ids"/>
                <field name="categ_ids"/>
                <field name="section_ids"/>
                <group>
                    <filter string="Today" name="today" domain="[('received_date', '=', 'today')]"/>
                    <filter string="This Week" name="this_week" domain="[('received_date', '&gt;=', 'today -7d +1d')]"/>
                    <filter string="This Month" name="this_month" domain="[('received_date', '&gt;=', 'today -30d +1d')]"/>
                    <separator/>
                    <filter string="Active" name="active_only" domain="[('state', '!=', 'closed')]"/>
                </group>
                <group>
                    <filter string="Date" name="indent_date" domain="[]" context="{'group_by': 'indent_date'}"/>
                    <filter string="Requested By" name="requested_by" domain="[]" context="{'group_by': 'requested_by'}"/>
                    <filter string="Delivery From" name="delivery_from" domain="[]" context="{'group_by': 'delivery_from'}"/>
                    <filter string="Delivery To" name="delivery_to" domain="[]" context="{'group_by': 'delivery_to'}"/>
                    <filter string="Product" name="product_ids" domain="[]" context="{'group_by': 'product_ids'}"/>
                    <filter string="Product Category" name="categ_ids" domain="[]" context="{'group_by': 'categ_ids'}"/>
                    <filter string="Production Section" name="section_ids" domain="[]" context="{'group_by': 'section_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_indent_request_tree" model="ir.ui.view">
        <field name="name">indent.request.list</field>
        <field name="model">indent.request</field>
        <field name="arch" type="xml">
            <list
                    decoration-muted="state in ('draft')"
                    decoration-success="state in ('sent')"
                    decoration-info="state in ('locked')"
                    name="Indent Request"
                    default_order="received_date desc, id desc"
            >
                <field name="name"/>
                <field name="delivery_from"/>
                <field name="delivery_to"/>
                <field name="requested_by" optional="hide"/>
                <!-- <field name="employee_id"/> -->
                <field name="received_date"/>
                <field name="create_date" optional="hide"/>
                <field name="internal_transfer_status" optional="hide"/>
                <field name="manufacturing_order_status"/>
                <field
                        name="company_id"
                        groups="base.group_multi_company"
                        widget="selection"
                        optional="hide"
                />
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field
                        name="state"
                        widget="badge"
                        decoration-muted="state in ('draft')"
                        decoration-success="state in ('sent')"
                        decoration-info="state in ('locked')"
                />
                <button
                        name="action_get_internal_transfers"
                        type="object"
                        icon="fa-cubes"
                        title="Receipt / Internal Transfers"
                        invisible="state not in ('locked')"
                /> 
            </list>
        </field>
    </record>


    <record model="ir.actions.act_window" id="indent_request_form_action">
        <field name="name">Indent Requests</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">indent.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_only': 1, 'group_by': 'received_date:day'}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to start a new Indent request process.
            </p>
            <p>
                A Indent request is an instruction to Manufacturing to procure
                a certain quantity of materials services, so that they are
                available at a certain point in time.
            </p>
        </field>
    </record>

    <record id="view_indent_request_line_list" model="ir.ui.view">
        <field name="name">indent.request.list</field>
        <field name="model">indent.request.line</field>
        <field name="arch" type="xml">
            <list
                    decoration-muted="state in ('draft')"
                    decoration-success="state in ('sent')"
                    decoration-info="state in ('locked')"
                    name="Indent Request"
                    default_order="received_date desc, id desc"
                    create="false"
            >
                <field name="indent_number" readonly="1" force_save="1"/>
                <field name="product_id" options="{'no_create': True}" readonly="0"/>
                <!-- <field name="categ_id" force_save="1"/> -->
                <!-- <field name="default_code" readonly="0"/> -->
                <!-- <field name="hsn_code" readonly="0"/> -->
                <field name="product_qty" string="Demand" readonly="0"/>
                <field name="product_uom_id" readonly="0"/>
                <field name="comments" readonly="0" column_invisible="1"/>
                <field name="delivery_from" readonly="0"/>
                <field name="delivery_to" readonly="0"/>
                <field name="requested_by" widget="many2one_avatar_user" readonly="0"/>
                <field name="received_date" readonly="0"/>
                <field name="create_date" readonly="1"/>
                <field name="received_qty"
                    readonly="1"
                    force_save="1"
                    optional="hide"/>

                <field name="supplied_qty"
                    readonly="1"
                    force_save="1"
                    optional="hide"/>
                <field
                        name="company_id"
                        groups="base.group_multi_company"
                        widget="selection"
                        optional="hide"
                />
                <field name="name" readonly="0" column_invisible="1"/>
                <field
                        name="state"
                        widget="badge"
                        decoration-muted="state in ('draft')"
                        decoration-success="state in ('sent')"
                        decoration-info="state in ('locked')"
                />
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_indent_request_line_search" model="ir.ui.view">
        <field name="name">Indent Requests Lines</field>
        <field name="model">indent.request.line</field>
        <field name="arch" type="xml">
            <search string="Indent Request Lines">
                <field name="indent_number"/>
                <field name="product_id"/>
                <field name="default_code"/>
                <field name="hsn_code"/>
                <field name="categ_id"/>
                <field name="section_id"/>
                <group>
                    <filter string="Today" name="today" domain="[('received_date', '=', 'today')]"/>
                    <filter string="This Week" name="this_week" domain="[('received_date', '&gt;=', 'today -7d +1d')]"/>
                    <filter string="This Month" name="this_month" domain="[('received_date', '&gt;=', 'today -30d +1d')]"/>
                    <separator/>
                    <filter string="Active" name="active_only" domain="[('state', '!=', 'closed')]"/>
                </group>
                <group>
                    <filter string="Receiving Date" name="received_date" domain="[]" context="{'group_by': 'received_date'}"/>
                    <filter string="Product" name="product_id" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter string="Product Category" name="categ_id" domain="[]" context="{'group_by': 'categ_id'}"/>
                    <filter string="Production Section" name="section_id" domain="[]" context="{'group_by': 'section_id'}"/>
                </group>
            </search>
        </field>
    </record>

      <record model="ir.actions.act_window" id="indent_request_line_action">
        <field name="name">Indent Requests Lines</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">indent.request.line</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_active_only': 1, 'group_by': 'received_date:day'}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to start a new Indent request lines process.
            </p>
            <p>
                A Indent request line is an instruction to Manufacturing to procure
                a certain quantity of materials services, so that they are
                available at a certain point in time.
            </p>
        </field>
    </record>

    <record id="action_internal_transfers_from_origin" model="ir.actions.act_window">
        <field name="name">Internal Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('origin', '=', active_id.name), ('picking_type_code', '=', 'internal')]</field>
    </record>


    <!-- Top menu item -->

    <menuitem name="Indent Request"
      id="menu_indent_request_root"
      web_icon="harleys_customization,static/description/icon.png"
      action="indent_request_form_action"
      />

    <menuitem name="Indent Request" id="menu_indent_request" parent="harleys_customization.menu_indent_request_root"/>
    <menuitem name="Indent Requests" id="harleys_customization.menu_sub_indent_request" parent="harleys_customization.menu_indent_request"
              action="harleys_customization.indent_request_form_action"/>
    <menuitem name="Indent Request Lines" id="harleys_customization.menu_sub_indent_request_line" parent="harleys_customization.menu_indent_request"
              action="harleys_customization.indent_request_line_action"/>


    <!-- <record id="view_mrp_production_tree_editable" model="ir.ui.view">
      <field name="name">mrp.production.tree.editable</field>
      <field name="model">mrp.production</field>
      <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
      <field name="arch" type="xml">
        <list position="attributes">
          <attribute name="editable">bottom</attribute>
        </list>
      </field>
    </record> -->

  </data>
</odoo>
