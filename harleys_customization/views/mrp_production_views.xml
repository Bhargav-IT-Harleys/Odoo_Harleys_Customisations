<odoo>
    <record id="mrp_production_list_inherit" model="ir.ui.view">
        <field name="name">mrp.production.list.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_plan']" position="attributes">
                <attribute name="string">Send</attribute>
            </xpath>
            <xpath expr="//field[@name='components_availability']" position="attributes">
                <attribute name="invisible">state not in ['draft', 'confirmed', 'progress']</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="section"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="is_transfer_created" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="mrp_production_form_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='bom_div']" position="after">
                <field name="batch_size"/>
                <field name="batch_qty" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="section"/>
            </xpath>
            <xpath expr="//button[@name='action_assign']" position="attributes">
                <attribute name="string">Check Availability &amp; Reserve</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_id']" position="after">
                <field name="categ_id" string="Product Category"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_order_line_stock_move_tree" model="ir.ui.view">
        <field name="name">mrp.production.line.stock.move.tree</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_print_report"
                            string="Print PDF"
                            type="object"
                            class="btn-primary"
                            icon="fa-print"/>
                </header>
                <field name="mo_name" optional="hide"/>
                <field name="mo_date_start"/>
                <field name="mo_product_id" optional="hide"/>
                <field name="mo_section"/>
                <field name="location_id"/>
                <field name="qty_available" string="On Hand"/>
                <field name="mo_product_qty" optional="hide"/>
                <field name="mo_product_uom_id" optional="hide"/>
                <field name="product_id" string="MO line Prod."/>
                <field name="categ_id" optional="hide"/>
                <field name="parent_categ_id"/>
                <field name="product_uom_qty" string="MO Line Demand"/>
                <field name="product_uom" string="MO line UOM"/>
                <field name="is_transfer_created" optional="hide"/>

            </list>
        </field>
    </record>

    <record id="view_mrp_order_line_stock_move_pivot" model="ir.ui.view">
        <field name="name">mrp.production.line.stock.move.pivot</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <pivot string="Manufacturing Order Lines">
                <field name="mo_date_start" interval="day" string="MO Schedule Date"/>
                <field name="mo_name" string="MO Ref."/>
                <field name="mo_product_id" string="MO Product"/>
                <field name="mo_product_qty" string="MO Qty"/>
                <field name="mo_section" string="Prod.Sect."/>
                <field name="product_id" string="MO line Prod."/>
                <field name="categ_id" string="MO lines Prod.Catg."/>
                <field name="parent_categ_id" string="MO lines Prod.Parent Catg."/>
                <field name="product_uom" string="MO line UOM"/>
                <field name="mo_product_uom_id" string="MO Prod.UOM"/>
                <field name="product_uom_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_mrp_order_line_stock_move" model="ir.actions.act_window">
        <field name="name">Manufacturing Order Lines</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="view_mrp_order_line_stock_move_tree"/>
        <field name="domain">
            [('raw_material_production_id','!=',False),
             ('raw_material_production_id.state','=','confirmed'),
             ('warehouse_id.user_ids', 'in', [uid])]
        </field>
        <field name="context">
            {
                'group_by': ['mo_date_start:day', 'mo_section']
            }
        </field>
    </record>

    <record id="action_mrp_order_line_stock_move_consumption" model="ir.actions.act_window">
        <field name="name">MO Consumption</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="view_mrp_order_line_stock_move_tree"/>
        <field name="domain">
            [('raw_material_production_id','!=',False),
             ('raw_material_production_id.state','!=','cancel'),
             ('warehouse_id.user_ids', 'in', [uid])]
        </field>
        <field name="context">
            {
                'group_by': ['mo_date_start:day', 'mo_section']
            }
        </field>
    </record>
    
    <menuitem id="menu_mrp_order_lines" name="MO Material Requirments" parent="mrp.menu_mrp_manufacturing" action="action_mrp_order_line_stock_move" sequence="2"/>

    <menuitem id="menu_mrp_order_consumption" name="MO Consumption" parent="mrp.menu_mrp_manufacturing" action="action_mrp_order_line_stock_move_consumption" sequence="3"/>

</odoo>
