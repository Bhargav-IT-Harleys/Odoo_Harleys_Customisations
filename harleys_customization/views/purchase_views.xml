<?xml version="1.0" encoding="utf-8"?>
  <odoo>
    <record id="purchase_order_form_inherit_restrict_confirm" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.restrict.confirm</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Targets the primary action_confirm button -->
            <xpath expr="//button[@id='bid_confirm']" position="attributes">
                <attribute name="groups">purchase.group_purchase_manager</attribute>
            </xpath>
            
    
            <!-- Targets the secondary action_confirm button in the status bar -->
            <xpath expr="//button[@id='draft_confirm']" position="attributes">
                <attribute name="groups">purchase.group_purchase_manager</attribute>
            </xpath>
            <field name="partner_ref" position="after">
                <field name="purchase_type" required="1"/>
            </field>
            <xpath expr="//button[@name='action_rfq_send']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="purchase_order_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="purchase_type"/>
            </field>
        </field>
    </record>
    <record id="purchase_order_tree_inherit_po" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.po</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="purchase_type"/>
            </field>
        </field>
    </record>
  </odoo>
