<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.vendor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="function" position="before">
                <field name="supplier_rank" invisible="1"/>
                <field name="customer_rank" invisible="1"/>
                <field name="state" decoration-success="state=='approved'" decoration-danger="state=='rejected'"
                invisible="supplier_rank == 0 and customer_rank == 0"/>
            </field>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_sent" string="Send" type="object"
                      icon="fa-paper-plane"
                      class="oe_highlight"
                      invisible="parent_id or (supplier_rank == 0 and customer_rank == 0) or state not in ('draft', 'rejected')"/>
                    <button name="action_approve" string="Approve" type="object"
                      class="btn btn-success"
                      icon="fa-thumbs-up"
                      invisible="parent_id or (supplier_rank == 0 and customer_rank == 0) or state not in ('sent')"
                      groups="account.group_account_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                      class="btn btn-danger"
                      icon="fa-thumbs-down"
                      invisible="parent_id or (supplier_rank == 0 and customer_rank == 0) or state not in ('sent')"
                      groups="account.group_account_manager"/>
                </header>
            </xpath>
            <field name="ref" position="replace">
            </field>
            <field name="category_id" position="after">
                <field name="ref"/>
            </field>
            <field name="state" position="after">
                <field name="approved_by" invisible="supplier_rank == 0 and customer_rank == 0"/>
                <field name="approved_date" invisible="supplier_rank == 0 and customer_rank == 0"/>
            </field>
        </field>
    </record>

    <record id="bon_res_partner_only_tree_view" model="ir.ui.view">
        <field name="name">view.res.partner.tree.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="supplier_rank" invisible="1" column_invisible="1"/>
                <field name="customer_rank" invisible="1" column_invisible="1"/>
                <field name="state" decoration-success="state == 'approved'" invisible="supplier_rank == 0 and customer_rank == 0" optional="show"/>
            </xpath>
       </field>
    </record>

</odoo>
