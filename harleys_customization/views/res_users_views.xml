<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_hide_role" model="ir.ui.view">
        <field name="name">res.users.form.hide.role</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/group[@string='Roles']" position="attributes">
                <attribute name="string"> </attribute>
            </xpath>
            <xpath expr="//field[@name='role']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_users_tree_hide_role" model="ir.ui.view">
        <field name="name">res.users.list.hide.role</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='role']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
