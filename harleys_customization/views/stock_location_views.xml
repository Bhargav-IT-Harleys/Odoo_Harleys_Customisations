<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_view_custom" model="ir.ui.view">
        <field name="name">stock.location.form.operations.custom</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='additional_info']" position="after">
              <group name="operation_type" string="Harleys Customization">
                 <field name="material_request_picking_type_id" options="{'no_create': True}"/>
                 <field name="production_transfer_picking_type_id" options="{'no_create': True}"/>
              </group>
            </xpath>
        </field>
    </record>
    <record id="stock.menu_stock_scrap" model="ir.ui.menu">
        <field name="name">Inv Adjustments</field>
    </record>
    <record id="mrp.menu_mrp_scrap" model="ir.ui.menu">
        <field name="name">Inv Adjustments</field>
    </record>
    <record id="stock.action_stock_scrap" model="ir.actions.act_window">
        <field name="name">Inv Adjustments</field>
    </record>
    <record id="view_stock_scrap_reason_tag_tree" model="ir.ui.view">
        <field name="name">stock.scrap.reason.tag.tree</field>
        <field name="model">stock.scrap.reason.tag</field>
        <field name="arch" type="xml">
            <list string="Inv Adj Reason" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record model="ir.actions.act_window" id="stock_scrap_reason_tag_menu_action">
        <field name="name">Inv Adj Reason</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.scrap.reason.tag</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="stock_scrap_reason_tag_menu"
              parent="stock.menu_stock_config_settings"
              name="Inv Adj Reason"
              action="stock_scrap_reason_tag_menu_action"
              sequence="4"/>
</odoo>
