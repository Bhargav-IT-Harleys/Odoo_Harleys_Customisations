<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_operations_custom" model="ir.ui.view">
        <field name="name">stock.move.operations.form.custom</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expiration_date']" position="attributes">
                <attribute name="required">not picking_type_use_existing_lots</attribute>
            </xpath>
        </field>
    </record>   
</odoo>