<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_custom" model="ir.ui.view">
        <field name="name">stock.picking.form.custom</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']" position="attributes">
                <attribute name="widget">searchable_stock_move_one2many</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='quantity']" position="attributes">
                <attribute name="string">Trans Qty</attribute>
            </xpath>
            <xpath expr="//header//button[@name='action_cancel']" position="replace">
                <button name="action_cancel"
                    invisible="state not in ('assigned', 'confirmed', 'draft', 'waiting')"
                    string="Cancel"
                    groups="base.group_user"
                    type="object"
                    data-hotkey="x"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='lot_ids']" position="attributes">
                <attribute name="column_invisible">parent.state == 'draft' or parent.picking_type_code == 'internal'</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='lot_ids']" position="after">
                <field name="lot_ids" string="Batch" widget="stock_move_line_batch"
                    class="o_harleys_batch_cell"
                    optional="show"
                    column_invisible="parent.state == 'draft' or parent.picking_type_code != 'internal'"
                    groups="stock.group_production_lot"
                    invisible="not show_details_visible or has_tracking == 'none'"
                    options="{'create': [('parent.use_create_lots', '=', True)]}"
                    context="{'default_company_id': company_id, 'default_product_id': product_id, 'active_picking_id': parent.id}"
                    domain="[('product_id','=',product_id)]"/>
                <field name="move_line_ids" widget="stock_move_line_qty_editor" string="Batch Qty"
                    class="o_harleys_batch_cell"
                    optional="show"
                    column_invisible="parent.picking_type_code != 'internal'">
                    <list>
                        <field name="lot_id"/>
                        <field name="quantity"/>
                    </list>
                </field>
            </xpath>
            <xpath expr="//field[@name='move_ids']//button[@name='action_show_details']" position="attributes">
                <attribute name="invisible">not show_details_visible or parent.picking_type_code == 'internal'</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']//button[@name='action_show_details']" position="after">
                <button name="action_show_details" type="object" icon="fa-info-circle" title="Details"
                    invisible="not show_details_visible or parent.picking_type_code != 'internal'"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='location_final_id']" position="before">
                <field name="location_dest_id" string="Destination Location" optional="hide"
                    column_invisible="parent.picking_type_code != 'internal'"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='move_line_ids']" position="after">
                <field name="restrict_partner_id" string="Owner" optional="hide"
                    groups="stock.group_tracking_owner"
                    column_invisible="parent.picking_type_code != 'internal'"/>
            </xpath>
        </field>
    </record>
</odoo>
