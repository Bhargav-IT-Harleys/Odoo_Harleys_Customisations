<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="stock.menu_action_inventory_tree" name="Physical Inventory" parent="stock.menu_stock_adjustments" groups="stock.group_stock_manager" sequence="10" action="stock.action_view_inventory_tree"/>

    <record id="view_stock_quant_tree_inventory_editable_status" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.status</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="editable">top</attribute>
                <attribute name="default_order">write_date desc, create_date desc, id desc</attribute>
                <attribute name="js_class">physical_inventory_list</attribute>
            </xpath>
            <field name="last_count_date" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <button name="action_inventory_history" position="before">
                <field name="adjustment_status" widget="badge"
                       decoration-warning="adjustment_status == 'draft'" optional="show"/>
            </button>
        </field>
    </record>

    <record id="quant_search_view_location_panel" model="ir.ui.view">
        <field name="name">stock.quant.search.location.panel</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel>
                    <field name="location_id" select="one" string="Location" icon="fa-map-marker" depth="10"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree_location_gate" model="ir.ui.view">
        <field name="name">stock.quant.list.location.gate</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">stock_quant_locations_list</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree_editable_location_gate" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.location.gate</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">stock_quant_locations_list</attribute>
            </xpath>
        </field>
    </record>

</odoo>
