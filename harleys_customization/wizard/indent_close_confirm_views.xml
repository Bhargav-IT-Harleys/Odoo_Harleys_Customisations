<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_indent_close_confirm_form" model="ir.ui.view">
        <field name="name">indent.close.confirm.form</field>
        <field name="model">indent.close.confirm</field>
        <field name="arch" type="xml">

            <form string="Confirm Close" class="o_transfer_cancel_dialog">

                <div class="p-4 o_transfer_content">

                    <div class="text-center mb-4">

                        <i class="fa fa-lock text-danger" title="Locked"
                           style="font-size:56px;"/>

                        <h2 class="fw-bold mt-3 mb-2">
                            Confirm Indent Closure
                        </h2>

                        <p class="text-muted fs-5">
                            You are about to permanently close this
                            <strong>Indent Request</strong>.
                        </p>

                    </div>

                    <div class="alert alert-warning rounded-3 p-4 mb-4" role="alert">

                        <h5 class="mb-3">
                            <i class="fa fa-exclamation-triangle me-2"/>
                            What will happen?
                        </h5>

                        <div class="d-flex align-items-start mb-2">
                            <i class="fa fa-check-circle text-success me-2 mt-1"/>
                            <span>Status will be changed to <strong>Closed</strong>.</span>
                        </div>

                        <div class="d-flex align-items-start mb-2">
                            <i class="fa fa-check-circle text-success me-2 mt-1"/>
                            <span>All associated indent lines will be marked as <strong>Closed</strong>.</span>
                        </div>

                        <div class="d-flex align-items-start">
                            <i class="fa fa-check-circle text-success me-2 mt-1"/>
                            <span>No further modifications will be allowed.</span>
                        </div>

                    </div>

                    <div class="text-center text-muted">
                        <i class="fa fa-info-circle me-1"/>
                        Please ensure all manufacturing, transfers and approvals
                        have been completed before continuing.
                    </div>

                </div>

                <footer>

                    <!-- Smaller Destructive Button -->
                    <button
                        name="action_confirm"
                        type="object"
                        string="Yes, Close Request"
                        class="btn btn-danger px-3"
                    />

                    <!-- Large Cancel Button -->
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn btn-secondary btn-lg px-5 py-2"
                    />

                </footer>

            </form>

        </field>
    </record>

</odoo>
