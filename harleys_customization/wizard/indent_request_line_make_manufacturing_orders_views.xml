<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_indent_request_line_make_manufacturing_order" model="ir.ui.view">
        <field name="name">Indent Request Line Make Manufacturing Order</field>
        <field name="model">indent.request.line.make.manufacturing.order</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Create Draft MO">
                <newline />
                <group>
                </group>
                <newline />
                <separator string="New MO details:" />
                <newline />
                <newline />
                <group>
                    <field name="indent_request_line_ids" nolabel="1" colspan="2">
                        <list name="Details" create="false" editable="bottom">
                            <field name="indent_number" readonly="1" force_save="1"/>
                            <field name="source_line_id" column_invisible="1" force_save="1"/>
                            <field name="product_id" readonly="1" force_save="1"/>
                            <field name="name" readonly="1" force_save="1" />
                            <field name="product_qty" readonly="0"/>
                            <field
                                name="product_uom_id"
                                column_invisible="1"
                                groups="!uom.group_uom"
                                force_save="1"
                                
                            />
                            <field name="product_uom_id" groups="uom.group_uom" readonly="1" force_save="1"/>
                        </list>
                    </field>
                </group>
                <newline />
                <footer>
                    <button
                        name="make_manufacturing_order"
                        string="Create Draft MO"
                        type="object"
                        class="oe_highlight"
                    />
                    <button special="cancel" string="Cancel" class="oe_link" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_create_mo_with_validation" model="ir.actions.server">
        <field name="name">Create Draft MO</field>
        <field name="model_id" ref="harleys_customization.model_indent_request_line"/>
        <field name="binding_model_id" ref="harleys_customization.model_indent_request_line"/>
        <field name="state">code</field>
        <field name="code">
            action = records.action_create_mo()
        </field>
    </record>
</odoo>
