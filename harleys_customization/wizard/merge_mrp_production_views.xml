<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_merge_mrp_production_wizard_form" model="ir.ui.view">
        <field name="name">merge.mrp.production.wizard.form</field>
        <field name="model">merge.mrp.production.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge Manufacturing Orders">
                <group>
                    <field name="schedule_date"/>
                    <field name="finished_goods_location_id" options="{'no_create': True}"/>
                    <field name="select_all_sections"/>
                    <field name="section_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button
                        name="action_merge_manufacturing_orders"
                        string="Merge"
                        type="object"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_merge_mrp_production_wizard" model="ir.actions.act_window">
        <field name="name">Merge Manufacturing Orders</field>
        <field name="res_model">merge.mrp.production.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_merge_mrp_production_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_merge_mrp_production_mo_wizard"
        name="Merge Manufacturing Orders"
        parent="mrp.menu_mrp_manufacturing"
        action="action_merge_mrp_production_wizard"
        sequence="2"
        groups="mrp.group_mrp_manager"
    />
</odoo>
