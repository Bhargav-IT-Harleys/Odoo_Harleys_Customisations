<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_picking_close_confirm_form" model="ir.ui.view">
        <field name="name">stock.picking.close.confirm.form</field>
        <field name="model">stock.picking.close.confirm</field>
        <field name="arch" type="xml">
            <form string="Confirm Transfer Cancellation">
                <sheet class="p-4">
                    <div class="alert alert-warning border-0 rounded-4 text-center py-4">
                        <i class="fa fa-lock fa-3x text-warning mb-3"/>
                        <h2 class="fw-bold mb-3">
                            Confirm Internal Transfer Cancellation
                        </h2>
                        <p class="fs-5 mb-3">
                            You are about to cancel this internal transfer.
                        </p>
                        <div class="bg-white rounded-3 p-3 text-start mx-auto" style="max-width:550px;">
                            <ul class="mb-0 ps-3">
                                <li>The transfer will be cancelled and marked accordingly.</li>
                                <li>Reserved stock will be released back to inventory.</li>
                                <li>No further modifications will be allowed after cancellation.</li>
                            </ul>
                        </div>
                        <p class="mt-4 text-muted">
                            Please verify the transfer details before continuing.
                        </p>
                    </div>
                </sheet>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Yes, Cancel Transfer"
                        class="btn btn-primary"
                    />
                    <button
                        string="Go Back"
                        special="cancel"
                        class="btn btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
