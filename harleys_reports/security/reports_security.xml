<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_harleys_reports" model="ir.module.category">
        <field name="name">Harleys Reports</field>
        <field name="sequence">45</field>
    </record>
    <record id="privilege_harleys_reports" model="res.groups.privilege">
        <field name="name">Harleys Reports</field>
        <field name="category_id" ref="module_category_harleys_reports"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_harleys_reports" model="res.groups">
        <field name="name">Harleys Reports</field>
        <field name="privilege_id" ref="privilege_harleys_reports"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>
</odoo>
