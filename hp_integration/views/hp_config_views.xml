<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hp_configuration_list" model="ir.ui.view">
        <field name="name">hp.configuration.list</field>
        <field name="model">hp.configuration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="mobile_number"/>
                <field name="active"/>
                <field name="otp_verified"/>
            </list>
        </field>
    </record>

    <record id="view_hp_configuration_form" model="ir.ui.view">
        <field name="name">hp.configuration.form</field>
        <field name="model">hp.configuration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="company_id"/>
                    </group>

                    <group>
                        <field name="mobile_number"/>
                        <field name="outlet_id"/>
                        <field name="vendor_code"/>
                    </group>

                    <group>
                        <field name="base_url"/>
                        <field name="auth_url"/>
                        <field name="order_url"/>
                        <field name="webhook_url"/>
                    </group>

                    <group>
                        <field name="otp_verified"/>
                        <field name="active"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hp_configuration" model="ir.actions.act_window">
        <field name="name">Vendor Configuration</field>
        <field name="res_model">hp.configuration</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_hp_root"
        name="Integration Setup"
        sequence="90"/>

    <menuitem
        id="menu_hp_configuration"
        parent="menu_hp_root"
        action="action_hp_configuration"
        sequence="1"/>

</odoo>