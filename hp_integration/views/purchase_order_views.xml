<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_purchase_order_form_hyperpure" model="ir.ui.view">
        <field name="name">purchase.order.form.hyperpure</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_send_to_hyperpure"
                    string="Send to Hyperpure"
                    type="object"
                    class="btn-primary"
                    invisible="not show_hyperpure_button"
                />
            </xpath>
        </field>
    </record>
</odoo>