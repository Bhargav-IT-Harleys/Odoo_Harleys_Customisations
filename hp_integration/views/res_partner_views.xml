<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_partner_form_hyperpure" model="ir.ui.view">
        <field name="name">res.partner.hyperpure.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='supplier_rank']" position="after">

                <field name="is_hyperpure_vendor"/>

            </xpath>

        </field>
    </record>

</odoo>