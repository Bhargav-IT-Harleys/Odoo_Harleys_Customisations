<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hp_otp_wizard" model="ir.ui.view">
        <field name="name">hp.otp.wizard.form</field>
        <field name="model">hp.otp.wizard</field>
        <field name="arch" type="xml">
            <form string="OTP Verification">
                <group>
                    <field name="otp"/>
                </group>

                <footer>
                    <button
                        name="action_verify"
                        type="object"
                        string="Verify"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>