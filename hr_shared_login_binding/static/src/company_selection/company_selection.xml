<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="hr_shared_login_binding.LoginCompanySelectionItem">
    <span
        class="d-flex o_switch_company_item p-0 w-100"
        t-att-class="{
            'disabled': !isCompanyAllowed,
            'alert-secondary': isCompanySelected,
        }"
        t-att-data-company-id="props.company.id"
    >
        <div
            role="checkbox"
            tabindex="0"
            t-att-aria-checked="isCompanySelected ? 'true' : 'false'"
            t-att-aria-label="props.company.name"
            t-att-title="(isCompanySelected ? 'Deselect ' : 'Select ') + props.company.name"
            class="border-end"
            t-att-class="{ 'border-primary': isCompanySelected, 'disabled': !isCompanyAllowed }"
            t-on-click.stop="() => this.toggleCompany()"
            t-on-keydown.stop="(event) => this.onCheckboxKeydown(event)"
        >
            <span class="btn border-0 px-2" t-att-class="isCompanyAllowed ? 'btn-link text-primary' : 'disabled'">
                <i class="fa fa-fw py-1" t-att-class="isCompanySelected ? 'fa-check-square text-primary' : 'fa-square-o'"/>
            </span>
        </div>

        <div class="d-flex flex-grow-1 align-items-center py-0 ps-2">
            <span
                class="company_label text-body text-truncate"
                t-attf-style="padding-left:{{props.level * 20}}px;">
                <t t-out="props.company.name"/>
            </span>
        </div>
    </span>
</t>

<t t-name="hr_shared_login_binding.CompanySelectionOverlay">
    <t t-if="state.visible">
        <div class="o_harleys_company_popup_backdrop"/>
        <div class="modal d-block" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content p-4">
                    <p t-esc="message"/>
                    <div class="o_harleys_company_popup_list border rounded mb-3">
                        <t t-foreach="companies" t-as="entry" t-key="entry.company.id">
                            <SwitchCompanyItem company="entry.company" level="entry.level"/>
                        </t>
                    </div>
                    <button class="btn btn-primary w-100" t-att-disabled="!canConfirm" t-on-click="() => this.confirm()">
                        Confirm
                    </button>
                </div>
            </div>
        </div>
    </t>
</t>

</templates>
