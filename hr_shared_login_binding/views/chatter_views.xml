<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One <chatter/> xpath per model in models/chatter_mixins.py - see
         that file for why these specific models got mail.thread. -->
    <record id="view_groups_form_chatter" model="ir.ui.view">
        <field name="name">res.groups.form.chatter</field>
        <field name="model">res.groups</field>
        <field name="inherit_id" ref="base.view_groups_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>

