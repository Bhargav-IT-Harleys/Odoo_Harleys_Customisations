<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_attribution_bulk_import_form" model="ir.ui.view">
        <field name="name">hr.attribution.bulk.import.form</field>
        <field name="model">hr.attribution.bulk.import</field>
        <field name="arch" type="xml">
            <form string="Bulk Import Employee Attribution">
                <header>
                    <button name="action_generate_template" string="Download Template"
                            type="object" class="btn-secondary"/>
                    <button name="action_validate" string="Validate" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_discard_unresolved" string="Discard Unresolved" type="object"
                            class="btn-secondary"
                            invisible="state != 'validated' or unresolved_count == 0"
                            confirm="Remove all unresolved rows from this list? This only affects this wizard's preview, not any employee or user record."/>
                    <button name="action_apply" string="Apply" type="object"
                            class="btn-primary" invisible="state != 'validated'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group invisible="not template_file">
                        <field name="template_filename" invisible="1"/>
                        <field name="template_file" filename="template_filename" readonly="1"
                               string="Template (click to download)"/>
                    </group>
                    <group invisible="state != 'draft'">
                        <field name="import_filename" invisible="1"/>
                        <field name="import_file" filename="import_filename"
                               string="Import File (.xlsx or .csv, two columns: Functional Account Email, Employee Email)"/>
                    </group>
                    <group string="Result" invisible="state == 'draft'">
                        <field name="resolved_count"/>
                        <field name="unresolved_count"/>
                    </group>
                    <field name="line_ids" invisible="state == 'draft'">
                        <list decoration-danger="status == 'unresolved'">
                            <field name="functional_email"/>
                            <field name="employee_email"/>
                            <field name="functional_user_id"/>
                            <field name="employee_id"/>
                            <field name="status"/>
                            <field name="reason"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_attribution_bulk_import" model="ir.actions.act_window">
        <field name="name">Bulk Import Employee Attribution</field>
        <field name="res_model">hr.attribution.bulk.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_hr_attribution_bulk_import"
              name="Bulk Import Employee Attribution"
              action="action_hr_attribution_bulk_import"
              parent="base.menu_administration"
              groups="base.group_system"
              sequence="101"/>
</odoo>
