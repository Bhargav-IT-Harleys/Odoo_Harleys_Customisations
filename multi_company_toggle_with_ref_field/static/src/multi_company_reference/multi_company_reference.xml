<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    <t t-name="company_reference_id" t-inherit="web.SwitchCompanyItem" t-inherit-mode="extension">
        <xpath expr="//span//div[2]/span" position="replace">
            <span
                class="company_label text-body text-truncate"
                t-attf-style="padding-left:{{props.level * 20}}px;">
                <t t-out="props.company_reference"/>
            </span>
        </xpath>
    </t>

    <t t-name="current_company_reference_id" t-inherit="web.SwitchCompanyMenu" t-inherit-mode="extension">
        <xpath expr="//button" position="replace">
            <button data-hotkey="shift+u" t-att-disabled="isSingleCompany" t-att-title="user.activeCompany.name">
                <i class="fa fa-building d-lg-none"/>
                <span class="oe_topbar_name d-none d-lg-block text-truncate" t-esc="this.props.selected_company_reference"/>
            </button>
        </xpath>
    </t>
</templates>