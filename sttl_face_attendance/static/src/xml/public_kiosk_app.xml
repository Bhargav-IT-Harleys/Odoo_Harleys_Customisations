<?xml version="1.0" encoding="utf-8"?>
<template xml:space="preserve">

    <t t-name="sttl_face_attendance.public_kiosk_app_custom" t-inherit="hr_attendance.public_kiosk_app" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_hr_kiosk_mode_bottom')]//button[hasclass('btn-light')]" position="after">
            <t t-if="this.props.kioskMode !== 'barcode' and this.state.active_display === 'main'">
                <button t-on-click="() => this.initiateFaceAttendance()" class="btn btn-light btn-lg rounded-3">
                    <i class="fa fa-camera me-2"/>
                    <span>Face Attendance</span>
                </button>
            </t>
        </xpath>
    </t>

</template>
