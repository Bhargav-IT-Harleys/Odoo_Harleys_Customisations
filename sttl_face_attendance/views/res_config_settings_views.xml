<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_face_attendance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.face.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='kiosk_mode_setting_container']" position="inside">
                <setting string="Face Attendance Shift Duration"
                         help="Once this duration has elapsed, the face kiosk shows both Check In and Check Out for an employee with an open attendance.">
                    <field name="face_attendance_shift_hours"
                           required="1"
                           class="text-center"
                           style="width: 5ch;"/>
                    <span class="ms-2">Hours</span>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
